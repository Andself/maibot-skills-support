{
  "manifest_version": 2,
  "id": "anse.skills-support",
  "version": "0.4.3",
  "name": "Skills 技能管理",
  "description": "让麦麦办事更靠谱！安装、创建和管理 Skills，按步骤查资料、做任务，还能更新和还原技能。",
  "author": {
    "name": "Andself",
    "url": "https://github.com/Andself"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/Andself/maibot-skills-support",
    "documentation": "https://github.com/Andself/maibot-skills-support#readme",
    "issues": "https://github.com/Andself/maibot-skills-support/issues"
  },
  "host_application": {
    "min_version": "1.3.14",
    "max_version": "1.3.16"
  },
  "sdk": {
    "min_version": "2.16.0",
    "max_version": "2.16.99"
  },
  "capabilities": [
    "message.get_recent",
    "chat.get_private_streams",
    "send.text",
    "llm.generate"
  ],
  "dependencies": [
    {
      "type": "python_package",
      "name": "PyYAML",
      "version_spec": ">=6,<7"
    }
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "plugin_type": "management"
}
