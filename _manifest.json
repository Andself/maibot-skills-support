{
  "manifest_version": 2,
  "id": "anse.skills-support",
  "version": "0.3.0",
  "name": "Skills 技能管理",
  "description": "Agent Skills 文档加载、GitHub 安装、聊天安装命令与技能运行记录。",
  "author": {
    "name": "Andself",
    "url": "https://github.com/Andself"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/Andself/maibot-skills-support",
    "documentation": "https://github.com/Andself/maibot-skills-support#readme"
  },
  "host_application": {
    "min_version": "1.3.14",
    "max_version": "1.3.15"
  },
  "sdk": {
    "min_version": "2.16.0",
    "max_version": "2.16.99"
  },
  "capabilities": [
    "message.get_recent",
    "chat.get_private_streams",
    "send.text",
    "llm.generate"
  ],
  "dependencies": [
    {
      "type": "python_package",
      "name": "PyYAML",
      "version_spec": ">=6,<7"
    }
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
